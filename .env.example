APP_BIND=0.0.0.0:8080
APP_ORIGIN=https://chat.example.com
# Keep true in production. Set false only for loopback HTTP development.
APP_COOKIE_SECURE=true
APP_ACCESS_TOKEN=replace-with-at-least-32-random-bytes
DATABASE_PATH=/data/chat.db
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-provider-api-key
AI_DEFAULT_MODEL=replace-with-provider-model-id
AI_REQUEST_TIMEOUT_SECS=30
MODEL_CACHE_TTL_SECS=60
MAX_MESSAGE_CHARS=32000
MAX_CONTEXT_MESSAGES=100
MAX_CONTEXT_CHARS=200000
MAX_ACTIVE_GENERATIONS=4
RUST_LOG=info
